# systemd unit for Linux servers. Install:
#   sudo cp ajwa-web.service /etc/systemd/system/ && sudo systemctl daemon-reload
#   sudo systemctl enable --now ajwa-web
# Assumes the deploy folder was copied to /opt/ajwa-web and is owned by the user below.
[Unit]
Description=Ajwa Sanitary Inventory (web)
After=network-online.target
Wants=network-online.target

[Service]
User=ajwa
WorkingDirectory=/opt/ajwa-web
ExecStart=/usr/bin/java -Duser.timezone=Asia/Dhaka -jar /opt/ajwa-web/ajwa-web.jar
Restart=on-failure
RestartSec=10
SuccessExitStatus=143

[Install]
WantedBy=multi-user.target
